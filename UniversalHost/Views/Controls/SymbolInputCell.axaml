<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniversalHost.ViewModels.Windows"
             x:Class="UniversalHost.Views.Controls.SymbolInputCell">
  <StackPanel x:Name="EditorRoot" x:DataType="vm:SymbolInputViewModel" Spacing="6">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="偏移 / 下标" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Kind, Mode=TwoWay}"
                IsEnabled="{Binding CanEditInput}" />
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Inputs}" IsEnabled="{Binding CanEditInput}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SymbolNumberInputViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                           ParsingNumberStyle="Integer" ShowButtonSpinner="False" ClipValueToMinMax="False"
                           Width="120" ToolTip.Tip="{Binding Hint}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}"
               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
