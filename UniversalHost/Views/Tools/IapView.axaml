<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:UniversalHost.ViewModels.Tools"
			 xmlns:services="clr-namespace:UniversalHost.Services"
			 mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="110"
			 MinHeight="110"

			 x:DataType="vm:IapViewModel"
			 x:Class="UniversalHost.Views.Tools.IapView">

	<StackPanel
		Margin="5,0,0,0"
		VerticalAlignment="Center"
		Orientation="Vertical">

		<!--  文件路径  -->
		<StackPanel Orientation="Horizontal">
			<Button
				Margin="0"
				Command="{Binding SelectIapFileCommand}"
				CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
				Content="选择文件" />

			<TextBox
				IsReadOnly="False"
				Loaded="ShowIapFilePathEnd"
				TextChanged="ShowIapFilePathEnd"
				Width="272"
				ToolTip.Tip="支持绝对路径或相对 .uhprj 所在目录的路径，例如 .\BOOT.bin。"
				Text="{Binding Source={x:Static services:ProjectSaveService.Instance},Path=Settings.IapConfig.IapFilePath}" />
		</StackPanel>
		<!--  进度信息  -->
		<TextBlock
			Margin="0,2"
			TextWrapping="Wrap">
			<Run Text="{Binding StageTimestamp}" />
			<Run Text="  " />
			<Run Text="{Binding CurrentStage}" />
		</TextBlock>
		<!--  启停按钮和进度条  -->
		<StackPanel Orientation="Horizontal">
			<Button
				Margin="0"
				Command="{Binding StartIapCommand}"
				Content="开始升级" />

			<Button
				Margin="1,0,0,0"
				Command="{Binding CancelIapCommand}"
				Content="取消" />

			<!--  进度条  -->
			<ProgressBar
				Margin="1,0,0,0"
				Height="25"
				Maximum="100"
				HorizontalAlignment="Left"
				Minimum="0"
				Width="222"
				Value="{Binding IapProgressBar}" />
		</StackPanel>
	</StackPanel>
</UserControl>
