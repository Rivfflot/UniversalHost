<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:UniversalHost.Views.Documents"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"

             xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:vm="using:UniversalHost.ViewModels.Documents"
             x:DataType="vm:CurveMonitorViewModel"
             x:Class="UniversalHost.Views.Documents.CurveMonitorView">

    <UserControl.KeyBindings>
        <!-- 触发 ViewModel 中的 Command -->
        <KeyBinding Gesture="Space" Command="{Binding ToggleCurveItemVisiableCommand}" />
        <KeyBinding Gesture="E" Command="{Binding ToggleYAxisAutoScaleCommand}" />
        <KeyBinding Gesture="X" Command="{Binding ToggleMouseCoordinatesCommand}" />
        <KeyBinding Gesture="C" Command="{Binding ToggleNearestPointCommand}" />
        <KeyBinding Gesture="V" Command="{Binding ToggleVerticalCursorsCommand}" />
        <KeyBinding Gesture="B" Command="{Binding ToggleHorizontalCursorsCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <!-- 鼠标悬停时的行是伪类 drag-hover SystemAccentColorBrush -->
        <Style Selector="ListBoxItem.drag-hover">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
        </Style>
        <Style Selector="MenuItem.axis-auto-scale:checked /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundPressed}"/>
        </Style>
        <Style Selector="MenuItem.axis-auto-scale:checked /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPressed}"/>
        </Style>
        <Style Selector="MenuItem.measurement-mode:checked /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundPressed}"/>
        </Style>
        <Style Selector="MenuItem.measurement-mode:checked /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPressed}"/>
        </Style>
        <Style Selector="MenuItem.toolbar-icon-button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="MenuItem.toolbar-icon-button /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding CurvesLayout.LeftPanelLength, Mode=TwoWay}" MinWidth="10"/>
            <ColumnDefinition Width="1.3"/>
            <ColumnDefinition Width="*" MinWidth="20"/>
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Column="0"
            RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Menu
                Grid.Row="0"
                Padding="0"
                Height="25">
                <MenuItem Header="🔽" Classes="toolbar-icon-button" ToolTip.Tip="选择显示项">
                    <CheckBox Content="变量名" IsChecked="{Binding CurvesLayout.IsNameVisible}"/>
                    <CheckBox Content="别名" IsChecked="{Binding CurvesLayout.IsAliasVisible}"/>
                    <CheckBox Content="值" IsChecked="{Binding CurvesLayout.IsValueVisible}"/>
                    <CheckBox Content="单位" IsChecked="{Binding CurvesLayout.IsUnitVisible}"/>
                </MenuItem>
                <MenuItem
                    Header="➕"
                    Classes="toolbar-icon-button"
                    ToolTip.Tip="添加监控变量"
                    Command="{Binding OpenAddDisplaySymbolWindowCommand}"
                    Cursor="Hand"/>
                <MenuItem
                    Header="🔍"
                    ToolTip.Tip="自动更新Y轴自动适应，X轴恢复最大记录长度（E）"
                    Classes="toolbar-icon-button axis-auto-scale"
                    ToggleType="CheckBox"
                    IsChecked="{Binding CurvesLayout.IsYAxisAutoScaleEnabled, Mode=TwoWay}"
                    Cursor="Hand"/>
                <MenuItem
                    Header="⚙️"
                    Classes="toolbar-icon-button"
                    ToolTip.Tip="设置"
                    Cursor="Hand"/>
            </Menu>

            <Border Grid.Row="1" Height="0.5" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />

            <Menu
                Grid.Row="2"
                Padding="0"
                Height="25">
                <MenuItem
                    Classes="toolbar-icon-button measurement-mode"
                    ToolTip.Tip="显示鼠标坐标(X)"
                    ToggleType="CheckBox"
                    IsChecked="{Binding IsMouseCoordinatesEnabled, Mode=TwoWay}"
                    Cursor="Hand">
                    <MenuItem.Header>
                        <Viewbox Width="18" Height="18" Stretch="Uniform">
                            <Grid Width="22" Height="22">
                                <Path
                                    Data="M11,2.5 L11,7 M11,15 L11,19.5 M2.5,11 L7,11 M15,11 L19.5,11"
                                    Stroke="#795BC8"
                                    StrokeThickness="2.5"
                                    StrokeLineCap="Round" />
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Fill="#00A9E8"
                                    Stroke="#795BC8"
                                    StrokeThickness="1.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Viewbox>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem
                    Classes="toolbar-icon-button measurement-mode"
                    ToolTip.Tip="鼠标靠近所选曲线时显示曲线上最近的点坐标(C)"
                    ToggleType="CheckBox"
                    IsChecked="{Binding IsNearestPointEnabled, Mode=TwoWay}"
                    Cursor="Hand">
                    <MenuItem.Header>
                        <Viewbox Width="18" Height="18" Stretch="Uniform">
                            <Grid Width="22" Height="22">
                                <Path
                                    Data="M2.5,19.5 L2.5,2.5 M2.5,19.5 L20,19.5"
                                    Stroke="#B5A7DE"
                                    StrokeThickness="1.5"
                                    StrokeLineCap="Round" />
                                <Path
                                    Data="M3,15 L7,11 L11,14 L16,6 L20,9"
                                    Stroke="#795BC8"
                                    StrokeThickness="2.5"
                                    StrokeLineCap="Round" />
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Margin="13,3,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Fill="#00A9E8"
                                    Stroke="#795BC8"
                                    StrokeThickness="1.5" />
                            </Grid>
                        </Viewbox>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem
                    Classes="toolbar-icon-button measurement-mode"
                    ToolTip.Tip="垂直光标测量(V)"
                    ToggleType="CheckBox"
                    IsChecked="{Binding IsVerticalCursorsEnabled, Mode=TwoWay}"
                    Cursor="Hand">
                    <MenuItem.Header>
                        <Viewbox Width="18" Height="18" Stretch="Uniform">
                            <Grid Width="22" Height="22">
                                <Path
                                    Data="M6,2 L6,17 M15,2 L15,17"
                                    Stroke="#B5A7DE"
                                    StrokeThickness="1.5"
                                    StrokeLineCap="Round" />
                                <Path
                                    Data="M2,14 L6,11 L10,10 L15,7 L20,4"
                                    Stroke="#795BC8"
                                    StrokeThickness="1.8"
                                    StrokeLineCap="Round" />
                                <Ellipse
                                    Width="4.5"
                                    Height="4.5"
                                    Margin="3.75,8.75,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Fill="#00A9E8"
                                    Stroke="#795BC8"
                                    StrokeThickness="1.1" />
                                <Ellipse
                                    Width="4.5"
                                    Height="4.5"
                                    Margin="12.75,4.75,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Fill="#00A9E8"
                                    Stroke="#795BC8"
                                    StrokeThickness="1.1" />
                                <Path
                                    Data="M5.5,19 L15.5,19 M5.5,19 L7.5,17 M5.5,19 L7.5,21 M15.5,19 L13.5,17 M15.5,19 L13.5,21"
                                    Stroke="#00A9E8"
                                    StrokeThickness="1.6"
                                    StrokeLineCap="Round" />
                            </Grid>
                        </Viewbox>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem
                    Classes="toolbar-icon-button measurement-mode"
                    ToolTip.Tip="水平光标测量(B)"
                    ToggleType="CheckBox"
                    IsChecked="{Binding IsHorizontalCursorsEnabled, Mode=TwoWay}"
                    Cursor="Hand">
                    <MenuItem.Header>
                        <Viewbox Width="18" Height="18" Stretch="Uniform">
                            <Grid Width="22" Height="22">
                                <Path
                                    Data="M7,5 L20,5 M7,17 L20,17"
                                    Stroke="#795BC8"
                                    StrokeThickness="2.5"
                                    StrokeLineCap="Round" />
                                <Path
                                    Data="M4,7 L4,15 M4,7 L2,9 M4,7 L6,9 M4,15 L2,13 M4,15 L6,13"
                                    Stroke="#00A9E8"
                                    StrokeThickness="1.5"
                                    StrokeLineCap="Round" />
                            </Grid>
                        </Viewbox>
                    </MenuItem.Header>
                </MenuItem>
            </Menu>
            <!--  分隔线  -->
            <Border Grid.Row="3" Height="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />

            <ListBox
                Grid.Row="4"
                x:Name="SymbolList"
                ItemsSource="{Binding DisplayCurves}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedCurveItem}"

                DragDrop.DragOver="ListBox_DragOver"
                DragDrop.Drop="ListBox_Drop"
                Background="Transparent"
                Padding="0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,0.6"/>
                        <Setter Property="DragDrop.AllowDrop" Value="True" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Header="切换显示"
                            Command="{Binding ToggleCurveItemVisiableCommand}"
                            InputGesture="Space"
                            />
                        <MenuItem
                            Header="添加变量"
                            Command="{Binding OpenAddDisplaySymbolWindowCommand}"/>
                        <MenuItem
                            Header="移除变量"
                            Command="{Binding RemoveSelectedSymbolCommand}"/>
                        <MenuItem
                            Header="清空变量"
                            Command="{Binding ClearSelectedSymbolsCommand}"/>
                        <MenuItem
                            Header="复制变量名"
                            Command="{Binding CopySymbolNameCommand}"
                            CommandParameter="{Binding $parent[TopLevel]}"/>
                        <MenuItem
                            Header="复制变量值"
                            Command="{Binding CopySymbolValueCommand}"
                            CommandParameter="{Binding $parent[TopLevel]}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="0">
                            <DockPanel
                                PointerPressed="FirstRow_PointerPressed"
                                LastChildFill="False"
                                Background="Transparent">
                                <TextBlock
                                    Text="{Binding Runtime.Symbol.Name}"
                                    FontSize="14"
                                    Padding="1,0,0,0"
                                    IsVisible="{Binding  $parent[UserControl].DataContext.CurvesLayout.IsNameVisible}"/>
                                <TextBlock
                                    Text="{Binding Runtime.Symbol.Alias}"
                                    FontSize="14"
                                    Padding="1,0,0,0"
                                    IsVisible="{Binding  $parent[UserControl].DataContext.CurvesLayout.IsAliasVisible}"/>
                            </DockPanel>
                            <DockPanel LastChildFill="False">
                                <ToggleButton
                                    Height="16"
                                    Width="20"
                                    IsThreeState="False"
                                    Padding="0,0,1,0"
                                    CornerRadius="1.5"
                                    IsChecked="{Binding IsVisible}">
                                    <ToggleButton.Content>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            IsVisible="{Binding !$parent[ToggleButton].IsChecked}"
                                            Text="✖️"
                                            FontSize="10"/>
                                    </ToggleButton.Content>
                                    <ToggleButton.Styles>
                                        <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                            <Setter Property="TextElement.Background" Value="{Binding Brush}"/>
                                        </Style>
                                    </ToggleButton.Styles>
                                </ToggleButton>

                                <TextBlock Text="{Binding Runtime.ValueString}"
                                           FontSize="12"
                                           Padding="0"
                                           IsVisible="{Binding  $parent[UserControl].DataContext.CurvesLayout.IsValueVisible}"/>

                                <TextBlock Text="{Binding Runtime.Symbol.Unit}"
                                           FontSize="12"
                                           Padding="1,0,0,0"
                                           IsVisible="{Binding  $parent[UserControl].DataContext.CurvesLayout.IsUnitVisible}"/>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  此处应在底部显示测量结果  -->
            <Border Grid.Row="5"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    IsVisible="{Binding IsMeasurementReadoutVisible}">
                <StackPanel Margin="5" Spacing="4">
                    <TextBlock Text="{Binding MeasurementReadout.Title}"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MeasurementReadout.Target}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="{Binding MeasurementReadout.HasTarget}"/>
                    <TextBlock Text="{Binding MeasurementReadout.First}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MeasurementReadout.Second}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding MeasurementReadout.HasSecond}"/>
                    <TextBlock Text="{Binding MeasurementReadout.DeltaX}"
                               FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding MeasurementReadout.HasDeltaX}"/>
                    <TextBlock Text="{Binding MeasurementReadout.DeltaY}"
                               FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding MeasurementReadout.HasDeltaY}"/>
                    <TextBlock Text="{Binding MeasurementReadout.Status}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Opacity="0.75"
                               IsVisible="{Binding MeasurementReadout.HasStatus}"/>
                </StackPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1"
                      MinWidth="1.3"
                      ResizeDirection="Columns"
                      Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
                      Cursor="SizeWestEast"/>


        <ScottPlot:AvaPlot Grid.Column="2" x:Name="CurvePlot"/>

    </Grid>

</UserControl>
