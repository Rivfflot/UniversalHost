<Window
	x:Class="UniversalHost.Views.MainWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:views="using:UniversalHost"
	xmlns:vm="using:UniversalHost.ViewModels"
	xmlns:services="clr-namespace:UniversalHost.Services"
	xmlns:sys="clr-namespace:System;assembly=System.Runtime"
	Title="{Binding WindowTitle}"
	Width="1000"
	Height="700"
	WindowState="Maximized"
	x:DataType="vm:MainWindowViewModel"
	>

	<Window.Resources>
		<ResourceDictionary>
			<ContextMenu x:Key="DocumentTabStripItemContextMenu">
				<MenuItem Header="重命名" Command="{Binding $parent[Window].DataContext.RenameTabCommand}" CommandParameter="{Binding}"/>
				<MenuItem Header="添加标签页"  Command="{Binding $parent[Window].DataContext.CreateNewTabCommand}" IsEnabled="True"/>
			</ContextMenu>
		</ResourceDictionary>
	</Window.Resources>

	<Window.Styles>
		<Style Selector="MenuItem.version-info:disabled /template/ ContentPresenter#PART_HeaderPresenter">
			<Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForeground}"/>
			<Setter Property="Opacity" Value="0.8"/>
		</Style>
		<Style Selector="MenuItem.path-icon:disabled Viewbox">
			<Setter Property="Opacity" Value="0.35"/>
		</Style>
	</Window.Styles>

	<DockPanel>
		<!--  顶部菜单栏  -->
		<Menu x:Name="MainMenu" DockPanel.Dock="Top">
			<Menu.ItemsPanel>
				<ItemsPanelTemplate>
					<DockPanel LastChildFill="False" HorizontalAlignment="Stretch"/>
				</ItemsPanelTemplate>
			</Menu.ItemsPanel>
			<MenuItem Header="文件">
				<MenuItem
					Header="新建"
					Command="{Binding NewProjectFileCommand}"
					CommandParameter="{Binding $parent[Window]}"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=!IsConnected}"/>
				<MenuItem
					Header="打开"
					Command="{Binding OpenProjectFileCommand}"
					CommandParameter="{Binding $parent[Window]}"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=!IsConnected}"/>
				<MenuItem
					Command="{Binding SaveProjectCommand}"
					Header="保存"
					InputGesture="Ctrl+S"
					HotKey="Ctrl+S"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}"/>
				<MenuItem
					Header="另存为"
					Command="{Binding SaveAsProjectFileCommand}"
					CommandParameter="{Binding $parent[Window]}"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}" />
				<MenuItem
					Command="{Binding ReloadSymbolsCommand}"
					Header="重载符号表"
					InputGesture="Ctrl+R"
					HotKey="Ctrl+R"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=CanEditMonitorSymbol}" />
				<Separator />
				<MenuItem
					Header="日志查看器"
					Command="{Binding OpenLogViewerCommand}"
					InputGesture="Ctrl+L"/>
			</MenuItem>
			<MenuItem
				Command="{Binding OpenSettingWindowCommand}"
				Header="设置"
				InputGesture="Ctrl+,"
				HotKey="Ctrl+,"
				ToolTip.Tip="Ctrl + ,"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}" >
				<MenuItem.CommandParameter>
					<sys:Int32>0</sys:Int32>
				</MenuItem.CommandParameter>
			</MenuItem>
			<MenuItem Header="设备" IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}">
				<MenuItem
					Command="{Binding ShowDeviceInfomationCommand}"
					Header="设备信息"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsConnected}" />
				<MenuItem
					Header="连接设备"
					Command="{Binding ConnectDeviceCommand}"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=CanConnectDevice}" />
				<MenuItem
					Command="{Binding DisconnectDeviceCommand}"
					Header="断开设备"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsConnected}" />
				<MenuItem
					Command="{Binding OpenIapWindowCommand}"
					Header="在线升级"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}" />
				<MenuItem
					Command="{Binding OpenFaultRecordToolCommand}"
					Header="故障录波"
					/>
			</MenuItem>
			<MenuItem
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}"
				Header="监控">
				<MenuItem
					Header="开始监控"
					Command="{Binding StartMonitorCommand}"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=CanStartMonitor}"
					/>
				<MenuItem
					Header="停止监控"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsMonitoring}"
					Command="{Binding StopMonitorCommand}"/>
				<MenuItem
					Header="切换坐标自适应"
					Command="{Binding ToggleAllCurveYAxisAutoScaleCommand}"
					InputGesture="Ctrl+E"/>
				<MenuItem
					Header="监控设置"
					Command="{Binding OpenSettingWindowCommand}">
					<MenuItem.CommandParameter>
						<sys:Int32>2</sys:Int32>
					</MenuItem.CommandParameter>
				</MenuItem>
				<MenuItem
					Header="保存监控数据"
					Command="{Binding SaveMonitorDataCommand}"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=CanEditMonitorSymbol}"/>
				<MenuItem
					Header="读取监控数据"/>
				<MenuItem
					Header="新建表格监控窗口"
					Command="{Binding AddGridMonitorPanelCommand}"/>
				<MenuItem
					Header="新建曲线监控窗口"
					Command="{Binding AddCurveMonitorPanelCommand}"/>
				<MenuItem
					Header="新建位监控窗口"
					Command="{Binding AddBitsMonitorPanelCommand}"/>
			</MenuItem>
			<MenuItem
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}"
				Header="标定">
				<MenuItem
					Header="参数下发"
					Command="{Binding DownloadValuesCommand}"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsConnected}"
					InputGesture="Ctrl+D"/>
				<MenuItem
					Header="参数回传"
					Command="{Binding UploadValuesCommand}"
					IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsConnected}"
					InputGesture="Ctrl+F"/>
				<MenuItem
					Command="{Binding OpenSettingWindowCommand}"
					Header="标定设置">
					<MenuItem.CommandParameter>
						<sys:Int32>3</sys:Int32>
					</MenuItem.CommandParameter>
				</MenuItem>
				<MenuItem
					Header="新建标定窗口"
					Command="{Binding AddGridCalibratePanelCommand}"/>

				<MenuItem
					Header="保存参数"
					Command="{Binding SaveCalibrateParametersCommand}"/>

				<MenuItem
					Header="读取参数"
					Command="{Binding LoadCalibrateParametersCommand}"
					CommandParameter="{Binding $parent[Window]}"/>

			</MenuItem>

			<MenuItem Header="关于">
				<MenuItem Header="当前工程">
					<MenuItem.HeaderTemplate>
						<DataTemplate>
							<TextBlock Text="当前工程" />
						</DataTemplate>
					</MenuItem.HeaderTemplate>
					<MenuItem.Items>
						<MenuItem Header="{Binding Source={x:Static services:ProjectSaveService.Instance},Path=ProjectFilePath}"/>
					</MenuItem.Items>
				</MenuItem>
				<MenuItem Header="重置窗口布局"
						  IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}"
						  Command="{Binding ResetDockLayoutCommand}"
						  />
				<MenuItem Header="使用说明" Command="{Binding OpenUserManualCommand}" />
				<MenuItem Header="快捷键" Command="{Binding OpenShortcutsCommand}" />
				<MenuItem Header="项目地址" Command="{Binding OpenGitHubRepositoryCommand}" />
				<MenuItem Header="{Binding AppVersion}" Classes="version-info" IsEnabled="False" />
			</MenuItem>

			<MenuItem
				Command="{Binding ConnectDeviceCommand}"
				Header="🟩"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				Padding="0"
				FontSize="18"
				ToolTip.Tip="连接设备"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=CanConnectDevice}" />

			<MenuItem
				Command="{Binding DisconnectDeviceCommand}"
				Header="🟥"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				Padding="0"
				FontSize="18"
				ToolTip.Tip="断开设备"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsConnected}" />

			<Separator
				Height="NaN"
				Width="1"
				Margin="2,5"/>

			<MenuItem
				Command="{Binding ReloadSymbolsCommand}"
				Header="🔄"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				Padding="0"
				FontSize="18"
				Cursor="Hand"
				ToolTip.Tip="重新加载符号表"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=CanEditMonitorSymbol}" />

			<Separator
				Height="NaN"
				Width="1"
				Margin="2,5"/>

			<MenuItem
				Command="{Binding StartMonitorCommand}"
				Header="▶️"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				Padding="0"
				FontSize="18"
				ToolTip.Tip="开始监控"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=CanStartMonitor}" />

			<MenuItem
				Command="{Binding StopMonitorCommand}"
				Header="⏸️"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				Padding="0"
				FontSize="18"
				ToolTip.Tip="停止监控"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsMonitoring}" />

			<MenuItem
				Command="{Binding ToggleAllCurveYAxisAutoScaleCommand}"
				Header="🔍"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				FontSize="18"
				Padding="0"
				ToolTip.Tip="切换所有曲线窗口的坐标轴自动适应（状态不一致时全部开启）"
				ToolTip.ShowOnDisabled="True"
				HotKey="Ctrl+E"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}" />

			<MenuItem
				Command="{Binding AddGridMonitorPanelCommand}"
				Classes="path-icon"
				Cursor="Hand"
				Padding="0"
				ToolTip.Tip="新建表格监控窗口"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}">
				<MenuItem.Header>
					<Viewbox Width="22" Height="22" Margin="0,1,0,0" Stretch="Uniform" RenderTransform="translate(0px, 0.5px)">
						<Canvas Width="36" Height="36">
							<Path Data="M6,4 H30 A2,2 0 0 1 32,6 V30 A2,2 0 0 1 30,32 H6 A2,2 0 0 1 4,30 V6 A2,2 0 0 1 6,4 Z"
								Fill="#DCECF4" Stroke="#7993AD" StrokeThickness="1"/>
							<Path Data="M6,4 H30 A2,2 0 0 1 32,6 V11 H4 V6 A2,2 0 0 1 6,4 Z"
								Fill="#3B9ECF"/>
							<Path Data="M18,12 V31 M5,21 H31"
								Stroke="#8CA9BB" StrokeThickness="1.4"/>
							<Path Data="M8,16 H14 M22,16 H28 M8,26 H13 M22,26 H28"
								Stroke="#16B780" StrokeThickness="2.5" StrokeLineCap="Round"/>
						</Canvas>
					</Viewbox>
				</MenuItem.Header>
			</MenuItem>

			<MenuItem
				Command="{Binding AddCurveMonitorPanelCommand}"
				Header="📈"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				FontSize="18"
				Padding="0"
				ToolTip.Tip="新建曲线监控窗口"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}" />

			<MenuItem
				Command="{Binding AddBitsMonitorPanelCommand}"
				Header="🔢"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				FontSize="18"
				Padding="0"
				ToolTip.Tip="新建位监控窗口"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}" />

			<MenuItem
				Command="{Binding SaveMonitorDataCommand}"
				Header="💾"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				FontSize="18"
				Padding="0"
				ToolTip.Tip="保存监控数据。监控运行时不能操作。"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=CanEditMonitorSymbol}" />

			<Separator
				Height="NaN"
				Width="1"
				Margin="2,5"/>

			<MenuItem
				Command="{Binding AddGridCalibratePanelCommand}"
				Classes="path-icon"
				Cursor="Hand"
				Padding="0"
				ToolTip.Tip="新建表格标定窗口"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}">
				<MenuItem.Header>
					<Viewbox Width="22" Height="22" Margin="0,1,0,0" Stretch="Uniform" RenderTransform="translate(0px, 0.5px)">
						<Canvas Width="36" Height="36">
							<Path Data="M6,4 H30 A2,2 0 0 1 32,6 V30 A2,2 0 0 1 30,32 H6 A2,2 0 0 1 4,30 V6 A2,2 0 0 1 6,4 Z"
								Fill="#DCECF4" Stroke="#7993AD" StrokeThickness="1"/>
							<Path Data="M6,4 H30 A2,2 0 0 1 32,6 V11 H4 V6 A2,2 0 0 1 6,4 Z"
								Fill="#3B9ECF"/>
							<Path Data="M13,12 V30 M22,12 V30 M5,20 H31 M5,26 H31"
								Stroke="#8CA9BB" StrokeThickness="1.4"/>
							<Path Data="M19,28 L27,20 L31,24 L23,32 L18,32 Z"
								Fill="#F5A64B" Stroke="#A86A42" StrokeThickness="1"/>
							<Path Data="M25,22 L29,26"
								Stroke="#FFF4D9" StrokeThickness="1.5"/>
						</Canvas>
					</Viewbox>
				</MenuItem.Header>
			</MenuItem>

			<MenuItem
				Command="{Binding DownloadValuesCommand}"
				Header="⏬"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				FontSize="18"
				Padding="0"
				ToolTip.Tip="下载标定变量至设备"
				ToolTip.ShowOnDisabled="True"
				HotKey="Ctrl+D"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsConnected}" />

			<MenuItem
				Command="{Binding UploadValuesCommand}"
				Header="⏫"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				FontSize="18"
				Padding="0"
				ToolTip.Tip="从设备上传标定变量"
				ToolTip.ShowOnDisabled="True"
				HotKey="Ctrl+F"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsConnected}" />

			<MenuItem
				Command="{Binding SaveCalibrateParametersCommand}"
				Header="📝"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				FontSize="18"
				Padding="0"
				ToolTip.Tip="保存标定变量到文件"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}" />

			<MenuItem
				Command="{Binding LoadCalibrateParametersCommand}"
				CommandParameter="{Binding $parent[Window]}"
				Header="📄"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				FontSize="18"
				Padding="0"
				ToolTip.Tip="从文件读取标定变量"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}"
				/>

			<Separator
				Height="NaN"
				Width="1"
				Margin="2,5"/>

			<MenuItem
				Command="{Binding AddCommandPanelCommand}"
				Classes="path-icon"
				Cursor="Hand"
				Padding="0"
				ToolTip.Tip="新建指令窗口"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}">
				<MenuItem.Header>
					<Viewbox Width="22" Height="22" Margin="0,1,0,0" Stretch="Uniform" RenderTransform="translate(0px, 0.5px)">
						<Canvas Width="36" Height="36">
							<Path Data="M6,4 H30 A2,2 0 0 1 32,6 V30 A2,2 0 0 1 30,32 H6 A2,2 0 0 1 4,30 V6 A2,2 0 0 1 6,4 Z"
								Fill="#E1EAF5" Stroke="#99AEC8" StrokeThickness="1"/>
							<Path Data="M9,12 H16 M9,18 H14 M9,24 H16"
								Stroke="#7895B8" StrokeThickness="2.2" StrokeLineCap="Round"/>
							<Path Data="M17,18 H25 M22,14 L26,18 L22,22"
								Stroke="#22A8CD" StrokeThickness="2.8" StrokeJoin="Round" StrokeLineCap="Round"/>
							<Path Data="M29,12 V24"
								Stroke="#7895B8" StrokeThickness="2.5" StrokeLineCap="Round"/>
						</Canvas>
					</Viewbox>
				</MenuItem.Header>
			</MenuItem>

			<Separator
				Height="NaN"
				Width="1"
				Margin="2,5"/>

			<MenuItem
				Command="{Binding OpenFaultRecordToolCommand}"
				Header="💿"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				FontSize="18"
				Padding="0"
				ToolTip.Tip="打开故障录波窗口"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}"
				/>

			<MenuItem
				Command="{Binding OpenIapWindowCommand}"
				Header="⬇️"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				FontSize="18"
				Padding="0"
				ToolTip.Tip="打开在线升级窗口"
				ToolTip.ShowOnDisabled="True"
				IsEnabled="{Binding Source={x:Static services:GlobalStatus.Instance}, Path=IsProjectOpened}"
				/>

			<Separator
				Height="NaN"
				Width="1"
				Margin="2,5"/>

			<MenuItem
				Command="{Binding OpenLogViewerCommand}"
				Header="📋"
				Cursor="Hand"
				FontFamily="Apple Color Emoji, Noto Color Emoji"
				FontSize="18"
				Padding="0"
				HotKey="Ctrl+L"
				ToolTip.Tip="打开日志窗口">
			</MenuItem>

			<!-- 主题项，在最右边 -->
			<MenuItem
				DockPanel.Dock="Right"
				Command="{Binding ToggleThemeCommand}"
				Cursor="Hand"
				Padding="0"
				ToolTip.Tip="切换主题">
				<MenuItem.Header>
					<TransitioningContentControl Content="{Binding CurrentThemeIcon}">
						<!-- 定义过渡效果， 0.3 秒的淡入淡出 -->
						<TransitioningContentControl.PageTransition>
							<CrossFade Duration="0:0:0.3"/>
						</TransitioningContentControl.PageTransition>
						<TransitioningContentControl.ContentTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding}"
										   FontSize="18"
										   FontFamily="Apple Color Emoji, Noto Color Emoji"/>
							</DataTemplate>
						</TransitioningContentControl.ContentTemplate>
					</TransitioningContentControl>
				</MenuItem.Header>
			</MenuItem>

		</Menu>
		<!--  分隔线  -->
		<Border Height="1" DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
		<!--  主内容区域  -->
		<DockControl
			Factory="{Binding Factory}" BorderThickness="0"
			Layout="{Binding Layout}">
		</DockControl>

	</DockPanel>
</Window>
